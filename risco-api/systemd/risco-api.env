# Settings for the risco-api service. Install as /etc/default/risco-api, readable by root only,
# since it holds the panel's access code.

# The panel's address, with the port if it isn't 1000
RISCO_PANEL=192.168.1.10

# The access code from the panel's installer programming for the Configuration Software, which is
# not a keypad user code
RISCO_ACCESS_CODE=5678

# The address to serve the API on. The API has no authentication, so anyone who can reach this
# address can disarm the alarm.
RISCO_LISTEN=127.0.0.1:8080

# What to log, in tracing-subscriber's EnvFilter syntax; `info` by default
#RUST_LOG=risco=debug,info
